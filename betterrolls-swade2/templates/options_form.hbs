<section class="brsw-chat-form">
    <div class="brsw-chat-modifiers-window">
        <div id="brsw-gm-actions">
            {{#each action_groups}}
                <div>{{localize label}}</div>
                {{#each actions}}
                    <div data-action-name="{{name}}" class="brsw-selectable brsw-clickable brsw-action brsw-added{{#if enable}} brsw-selected{{/if}}">
                        {{localize name}}
                    </div>
                {{/each}}
            {{/each}}
        </div>
    </div>
</section>