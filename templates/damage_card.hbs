{{>"modules/betterrolls-swade2/templates/common_card_header.hbs"}}
<div class="brsw-damage-header-row">
    <div>{{{text}}}</div>
    <button class="brsw-form brsw-row-button brsw-undo-damage" title="{{localize 'BRSW.UndoDamage'}}">
        <i class="fas fa-undo"></i>
    </button>
</div>
{{#if traitRoll.rolls}}
    {{>"modules/betterrolls-swade2/templates/trait_roll_partial.hbs"}}
    {{>"modules/betterrolls-swade2/templates/trait_result_partial.hbs"}}
{{else}}
    {{#if soak_possible}}
        <div class="brsw-button-row brsw-form brsw-card-row brsw-card-row-divider">
            <button class="brsw-soak-button brsw-full-button">
                <img src="{{{benny_image}}}" class="brsw-button-image brsw-soak-benny" alt="Cost bennie"> {{localize 'BRSW.SoakRoll'}}
            </button>
        </div>
    {{/if}}
{{/if}}
{{#if show_incapacitation}}
    <div class="brsw-button-row brsw-form brsw-card-row brsw-card-row-divider">
        <button class="brsw-show-incapacitation brsw-full-button">
            {{localize "BRSW.IncapacitationCard"}}
        </button>
    </div>
    <div class="brsw-button-row brsw-form brsw-card-row">
        <button class="brsw-mark-defeated brsw-full-button">
            {{localize "BRSW.MarkDefeated"}}
        </button>
    </div>
{{/if}}
{{#if showInjury}}
    <div class="brsw-button-row brsw-form brsw-card-row brsw-card-row-divider">
        <button class="brsw-injury-button brsw-full-button">
            {{localize 'BRSW.RollInjury'}}
        </button>
    </div>
{{/if}}