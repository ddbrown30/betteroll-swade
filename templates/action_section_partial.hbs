<div class="brsw-action-section">
    <h2 class="brsw-action-section-header">
        {{br2-cap (localize name)}}
    </h2>
    <div class="brsw-action-section-groups">
        {{#each section}}
            <fieldset class="brsw-action-group">
                <legend class="brsw-action-group-name">{{this.name}}</legend>
                <div class="brsw-action-buttons" {{#if this.single_choice}}data-single-choice="true" {{/if}}>
                    {{#each this.actions}}
                        <span class="brsw-action-button{{#if this.selected}} brsw-action-button-selected{{/if}}" data-action-id="{{this.code.id}}" style="display: inline-block">
                            {{#if this.has_skill_mod}}<i class="fas fa-bullseye"></i>{{/if}}
                            {{#if this.has_damage_mod}}<i class="fas fa-tint"></i>{{/if}} {{this.name}}
                        </span>
                    {{/each}}
                </div>
            </fieldset>
        {{/each}}
    </div>
</div>