<div class="brsw-dialog-content">
    <div class="brsw-dialog-header">
        <h2 class="brsw-dialog-title">
            {{BrCard.render_data.header.title}}
        </h2>
        <button type="button" class="brsw-dialog-close-btn brsw-cancel">
            <svg class="brsw-dialog-close-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"></path>
            </svg>
            <span class="sr-only">Close modal</span>
        </button>
    </div>
    <div class="brsw-actions-scrollable">
        {{#if sections.common}}
            {{>"modules/betterrolls-swade2/templates/action_section_partial.hbs" name="BRSW.ActionSection.Common" section=sections.common}}
        {{/if}}
        {{#if sections.character}}
            {{>"modules/betterrolls-swade2/templates/action_section_partial.hbs" name="BRSW.ActionSection.Character" section=sections.character}}
        {{/if}}
        {{#if sections.attack}}
            {{>"modules/betterrolls-swade2/templates/action_section_partial.hbs" name="BRSW.ActionSection.Attack" section=sections.attack}}
        {{/if}}
        {{#if sections.power}}
            {{>"modules/betterrolls-swade2/templates/action_section_partial.hbs" name="BRSW.ActionSection.Power" section=sections.power}}
        {{/if}}
        {{#each sections.other}}
            {{>"modules/betterrolls-swade2/templates/action_section_partial.hbs" name=(br2-cap @key) section=this}}
        {{/each}}
        <div class="brsw-unlisted-actions">
            {{#each sections.none}}
                <div>
                    <div>
                        <h2 class="brsw-unlisted-action-header">
                            {{this.name}} {{#if this.single_choice}} (Single choice){{/if}}
                        </h2>
                    </div>
                    <div class="brsw-unlisted-action-buttons" {{#if this.single_choice}}data-single-choice="true" {{/if}}>
                        {{#each this.actions}}
                            <span class="brsw-action-button{{#if this.selected}} brsw-action-button-selected{{/if}}" data-action-id="{{this.code.id}}" style="display: inline-block">
                                {{#if this.has_skill_mod}}<i class="fas fa-bullseye"></i>{{/if}}
                                {{#if this.has_damage_mod}}<i class="fas fa-tint"></i>{{/if}} {{this.name}}
                            </span>
                        {{/each}}
                    </div>
                </div>
            {{/each}}
        </div>
    </div>
    <div class="brsw-dialog-footer">
        <button type="button" id="brsw-save-button" class="brsw-dialog-button">
            Set
        </button>
        {{#unless BrCard.trait_roll.is_rolled}}
            <button type="button" id="brsw-dialog-roll" class="brsw-dialog-button">
                <i class="fas fa-dice"></i> {{localize 'BRSW.Roll'}}
            </button>
        {{/unless}}
        <button type="button" class="brsw-cancel brsw-dialog-button brsw-dialog-button-cancel">
            <i class="fas fa-times"></i> Cancel
        </button>
    </div>
</div>