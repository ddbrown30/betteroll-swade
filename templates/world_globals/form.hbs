<div class="scrollable">
    <h2>{{localize "BRSW.Settings.WorldGlobalMenu.Label"}}</h2>
    <div class="brsw-action-list">
        {{#each actions}}
            <span data-formId="{{this.formId}}">
                <h2 class="brsw-accordion">
                    <button type="button" data-action="accordion" class="brsw-accordion-button{{#if @first}} brsw-accordion-top{{/if}}">
                        <span>{{this.id}}</span>
                    </button>
                </h2>
                <div class='brsw-edit-action brsw-collapsed'>
                    <textarea class='brsw-action-json' name="{{this.formId}}" rows="9">{{this.json}}</textarea>
                    <i data-action="trash" class="brsw-red-text fas fa-trash brsw-clickable"></i>
                </div>
            </span>
        {{/each}}
    </div>
</div>