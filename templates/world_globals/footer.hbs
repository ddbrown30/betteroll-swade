<footer>
    <button type="button" data-action="newAction" class="brsw-new-action brsw-footer-button">
        <i class="fas fa-plus"></i> {{localize "BRSW.NewAction"}}
    </button>
    <div class="brsw-action-button-group">
        <button type="submit" class="brsw-footer-button">
            <i class="fas fa-save"></i> {{localize "BRSW.Save"}}
        </button>
        <button type="button" data-action="export" class="brsw-export-json brsw-footer-button">
            <i class="fas fa-save"></i> {{localize "BRSW.Export"}}
        </button>
        <button type="button" data-action="import" class="brsw-import-json brsw-footer-button">
            <i class="fas fa-file-import"></i> {{localize "BRSW.Import"}}
        </button>
    </div>
</footer>