<div class="brsw-card">
    {{>"modules/betterrolls-swade2/templates/common_card_header.hbs"}}
    {{#if notes}}
        <div class="twbr:w-full twbr:text-center twbr:font-bold">{{{notes}}}</div>
    {{/if}}
    {{#if skill}}
        <div class="twbr:relative twbr:flex twbr:justify-between">
            <span class="twbr:group">
                <span class="twbr:text-lg">
                    {{skill_title}}
                </span>
                {{#if skill_tooltip}}
                    <div class="twbr:w-52 twbr:opacity-0 twbr:collapse twbr:absolute
                        twbr:group-hover:visible twbr:group-hover:opacity-100 twbr:group-hover:h-auto
                        twbr:transition-opacity twbr:group-hover:delay-1000 twbr:group-hover:duration-500
                        twbr:px-3 twbr:py-2 twbr:text-sm twbr:font-medium twbr:text-white
                        twbr:bg-gray-900 twbr:rounded-lg twbr:shadow-sm" role="tooltip">
                        {{{skill_tooltip}}}
                    </div>
                {{/if}}
            </span>
            {{#if ammo}}
                <span>
                    <span class="brws-common-modifiers brsw-form twbr:flex">
                        {{#if showShotsPPInfo}}
                            <span class="twbr:self-center brsw-shots-pp">{{shots_pp_info}}</span>
                        {{/if}}
                        <img src="modules/betterrolls-swade2/assets/bullet.svg" alt="ammo" title="{{localize 'BRSW.SubtractAmmo'}}" class="twbr:w-6 brsw-ammo-toggle twbr:cursor-pointer twbr:border twbr:border-solid
                            twbr:border-slate-400 twbr:m-1 twbr:rounded twbr:hover:ring-2
                            twbr:hover:ring-offset-1
                            {{#if subtract_selected}}twbr:bg-red-700{{else}}twbr:bg-gray-500{{/if}}
                            twbr:hover:bg-gray-900">
                        <img src="modules/betterrolls-swade2/assets/cycle.svg" alt="reload" title="{{localize 'BRSW.ManualAmmo'}}" class="twbr:w-6 brsw-ammo-manual twbr:cursor-pointer twbr:bg-transparent twbr:border
                            twbr:border-slate-400 twbr:m-1 twbr:rounded twbr:hover:ring-2 twbr:hover:ring-offset-1
                            twbr:hover:invert">
                    </span>
                </span>
            {{/if}}
        </div>
        <div class="twbr:relative twbr:flex twbr:justify-between">
            {{#if is_power}}
                <span class="brws-common-modifiers brsw-form twbr:flex twbr:grow twbr:gap-1">
                    {{#if showShotsPPInfo}}
                        <div class="twbr:self-center">
                            <span class="twbr:font-bold">{{localize "BRSW.PPCurrent"}}: </span>
                            <span class="brsw-shots-pp">{{shots_pp_info}}</span>
                        </div>
                        <div class="twbr:self-center">
                            <span class="twbr:font-bold">{{localize "BRSW.PPCost"}}: </span>
                            <span class="brsw-pp-cost">{{pp_cost}}</span>
                        </div>
                    {{/if}}
                    <div class="twbr:flex twbr:ml-auto">
                        <img src="modules/betterrolls-swade2/assets/electric.svg" alt="power point" title="{{localize 'BRSW.SubtractPP'}}" class="twbr:w-6 brsw-pp-toggle twbr:cursor-pointer twbr:border twbr:border-solid
                                            twbr:border-slate-400 twbr:m-1 twbr:rounded twbr:hover:ring-2 twbr:hover:ring-offset-1
                                            {{#if subtractPP}}twbr:bg-red-700{{else}}twbr:bg-gray-500{{/if}}
                                            twbr:hover:bg-gray-900">
                        <img src="modules/betterrolls-swade2/assets/magic-swirl.svg" alt="reload" title="{{localize 'BRSW.ManualPP'}}" class="twbr:w-6 brsw-pp-manual twbr:cursor-pointer twbr:bg-transparent twbr:border
                                            twbr:border-solid twbr:border-slate-400 twbr:m-1 twbr:rounded twbr:hover:ring-2
                                            twbr:hover:ring-offset-1 twbr:hover:invert">
                    </div>
                </span>
            {{/if}}
        </div>
    {{/if}}
    {{#if applicable_effects}}
        <p>{{localize 'BRSW.ApplicableEffects'}}</p>
        {{#each applicable_effects}}
            <a class="twbr:p-1 twbr:rounded twbr:border-solid twbr:border twbr:border-gray-500 twbr:text-gray-700 twbr:m-1 twbr:text-xs twbr:cursor-move" draggable="true" data-uuid="{{this.uuid}}" data-id="{{this.id}}" data-type="ActiveEffect" data-tooltip="Active Effect" data-tooltip-text="Base Active Effect" data-link="" style="display: inline-block">
                {{this.name}}
            </a>
        {{/each}}
    {{/if}}
    {{#if (or damage skill)}}
        {{>"modules/betterrolls-swade2/templates/actions_partial.hbs"}}
    {{/if}}
    {{#if skill}}
        {{>"modules/betterrolls-swade2/templates/trait_roll_partial.hbs"}}
        {{>"modules/betterrolls-swade2/templates/trait_result_partial.hbs"}}
    {{/if}}
    {{#if damage}}
        <div class="brsw-form brsw-button-row brsw-form-options twbr:pt-2">
            <span>
                {{localize 'BRSW.Damage'}}
            </span>
            <span class="twbr:flex twbr:gap-1">
                <button id="roll-damage" class="brsw-damage-button brsw-form twbr:py-0.5 twbr:px-5
                     twbr:font-medium twbr:focus:outline-hidden twbr:bg-white twbr:rounded-lg
                     twbr:border twbr:border-solid twbr:focus:z-10 twbr:focus:ring-4
                     twbr:focus:ring-gray-700 twbr:text-gray-800 twbr:border-gray-600
                     twbr:hover:text-white twbr:hover:bg-gray-700" title="{{localize 'BRSW.Damage'}}">
                    <i class="fas fa-dice"></i>
                </button>
                <button id="roll-raise-damage" class="brsw-damage-button brsw-form twbr:py-0.5 twbr:px-5
                    twbr:font-medium twbr:focus:outline-hidden twbr:bg-white twbr:rounded-lg
                    twbr:border twbr:border-solid twbr:focus:z-10 twbr:focus:ring-4
                    twbr:focus:ring-gray-700 twbr:text-gray-800 twbr:border-gray-600
                    twbr:hover:text-white twbr:hover:bg-gray-700" title="{{localize 'BRSW.RaiseDamage'}}">
                    <i class="fas fa-plus"></i><i class="fas fa-dice-six"></i>
                </button>
            </span>
        </div>
        {{>"modules/betterrolls-swade2/templates/damage_partial.hbs"}}
    {{/if}}
    {{#if swade_templates}}
        <div class="brsw-form">
            <h4 class="brsw-item-subheading">
                <i class="fa-solid fa-ruler-combined"></i> {{localize 'BRSW.Templates'}}
            </h4>
            <div class="brsw-form-options twbr:mb-2 twbr:gap-1">
                {{#each swade_templates}}
                    <button class="brsw-template-button brsw-sub-button twbr:py-0.5 twbr:px-0.5
                twbr:font-medium twbr:focus:outline-hidden twbr:bg-white twbr:rounded-lg twbr:border
                twbr:border-solid twbr:focus:z-10 twbr:focus:ring-4 twbr:focus:ring-gray-700
                twbr:text-gray-800 twbr:border-gray-600 twbr:hover:text-white twbr:hover:bg-gray-700
                twbr:w-full" data-size="{{this.type}}"><i class="fas fa-ruler-combined"></i> {{localize this.label}}</button>
                {{/each}}
            </div>
        </div>
    {{/if}}
    {{#if (eq item.type "consumable")}}
        <div class='brsw-consumable-charges'>
            {{localize 'SWADE.Charges'}}:
            <span class='current-pp'>{{item.system.charges.default.value}}</span>
            &nbsp;/&nbsp;
            <span class='max-pp'>{{item.system.charges.default.max}}</span>
        </div>
        <button class="brsw-use-consumable-button brsw-sub-button brsw-form twbr:py-0.5 twbr:px-5 twbr:w-full
            twbr:font-medium twbr:focus:outline-hidden twbr:bg-white twbr:rounded-lg
            twbr:border twbr:border-solid twbr:focus:z-10 twbr:focus:ring-4
            twbr:focus:ring-gray-700 twbr:text-gray-800 twbr:border-gray-600
            twbr:hover:text-white twbr:hover:bg-gray-700">
            {{localize 'SWADE.Consumable.Use'}}
        </button>
    {{/if}}
    {{#if has_feet_buttons}}
        {{#if macro_buttons}}
            <div class="brsw-form">
                <h4 class="brsw-item-subheading">
                    <i class="fa-solid fa-code"></i> {{localize 'BRSW.Macros'}}
                </h4>
                <div class="brsw-item-action-button-group">
                    {{#each macro_buttons}}
                        <button class="brsw-macro-button brsw-sub-button twbr:py-0.5 twbr:px-0.5 twbr:w-full
                    twbr:font-medium twbr:focus:outline-hidden twbr:bg-white twbr:rounded-lg twbr:border
                    twbr:border-solid twbr:focus:z-10 twbr:focus:ring-4 twbr:focus:ring-gray-700
                    twbr:text-gray-800 twbr:border-gray-600 twbr:hover:text-white twbr:hover:bg-gray-700" data-macro="{{this.key}}"><i class="fas fa-code"></i> {{this.name}}</button>
                    {{/each}}
                </div>
            </div>
        {{/if}}
        {{#if resist_buttons}}
            <div>
                <h4 class="brsw-item-subheading">
                    <i class="fa-solid fa-ban"></i> {{localize 'BRSW.Resistance'}}
                </h4>
                <div class="brsw-item-action-button-group">
                    {{#each resist_buttons}}
                        <button class="brsw-resist-button brsw-sub-button twbr:py-0.5 twbr:px-0.5 twbr:w-full
                        twbr:font-medium twbr:focus:outline-hidden twbr:bg-white twbr:rounded-lg
                        twbr:border twbr:border-solid twbr:focus:z-10 twbr:focus:ring-4 twbr:focus:ring-gray-700
                        twbr:text-gray-800 twbr:border-gray-600 twbr:hover:text-white twbr:hover:bg-gray-700" data-trait="{{this.trait}}" data-trait-mod="{{this.trait_mod}}">
                            <i class="fa-solid fa-ban"></i> {{this.name}}
                        </button>
                    {{/each}}
                </div>
            </div>
        {{/if}}
    {{/if}}
</div>