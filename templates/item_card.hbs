<div class="brsw-card">
    {{>"modules/betterrolls-swade2/templates/common_card_header.hbs"}}
    {{#if notes}}
        <div class="brsw-item-notes">{{{notes}}}</div>
    {{/if}}
    {{#if trait}}
        <div class="brsw-trait-row">
            <span class="brsw-trait-group">
                <span class="brsw-trait-title">
                    {{traitTitle}}
                </span>
                {{#if skill_tooltip}}
                    <div class="brsw-tooltip" role="tooltip">
                        {{{skill_tooltip}}}
                    </div>
                {{/if}}
            </span>
            {{#if ammo}}
                <span>
                    <span class="brsw-common-modifiers brsw-form brsw-flex">
                        <span class="brsw-self-center brsw-shots-pp">{{shots_pp_info}}</span>
                        <img src="modules/betterrolls-swade2/assets/bullet.svg" alt="ammo" title="{{localize 'BRSW.SubtractAmmo'}}" class="brsw-toggle-icon brsw-ammo-toggle{{#if subtract_selected}} brsw-toggle-active{{/if}}">
                        <img src="modules/betterrolls-swade2/assets/cycle.svg" alt="reload" title="{{localize 'BRSW.ManualAmmo'}}" class="brsw-toggle-icon brsw-ammo-manual">
                    </span>
                </span>
            {{/if}}
        </div>
        {{#if is_power}}
            <div class="brsw-trait-row">
                <span class="brsw-common-modifiers brsw-form brsw-flex brsw-grow brsw-gap-1">
                    {{#if noPowerPoints}}
                        <div class="brsw-self-center">
                            <span class="brsw-label-bold">{{localize "BRSW.PPPenalty"}}: </span>
                            <span class="brsw-pp-penalty">{{ppPenalty}}</span>
                        </div>
                    {{else}}
                        <div class="brsw-self-center">
                            <span class="brsw-label-bold">{{localize "BRSW.PPCurrent"}}: </span>
                            <span class="brsw-shots-pp">{{shots_pp_info}}</span>
                        </div>
                        <div class="brsw-self-center">
                            <span class="brsw-label-bold">{{localize "BRSW.PPCost"}}: </span>
                            <span class="brsw-pp-cost">{{pp_cost}}</span>
                        </div>
                    {{/if}}
                    <div class="brsw-flex brsw-ml-auto">
                        {{#unless noPowerPoints}}
                            <img src="modules/betterrolls-swade2/assets/electric.svg" alt="power point" title="{{localize 'BRSW.SubtractPP'}}" class="brsw-toggle-icon brsw-pp-toggle{{#if subtractPP}} brsw-toggle-active{{/if}}">
                        {{/unless}}
                        <img src="modules/betterrolls-swade2/assets/magic-swirl.svg" alt="reload" title="{{localize 'BRSW.PPManagement.Button'}}" class="brsw-toggle-icon brsw-pp-manual">
                    </div>
                </span>
            </div>
        {{/if}}
    {{/if}}
    {{#if applicable_effects}}
        <p>{{localize 'BRSW.ApplicableEffects'}}</p>
        {{#each applicable_effects}}
            <a class="brsw-effect" draggable="true" data-uuid="{{this.uuid}}" data-id="{{this.id}}" data-type="ActiveEffect" data-tooltip="Active Effect" data-tooltip-text="Base Active Effect" data-link="" style="display: inline-block">
                {{this.name}}
            </a>
        {{/each}}
    {{/if}}
    {{#if showActions}}
        {{>"modules/betterrolls-swade2/templates/actions_partial.hbs"}}
    {{/if}}
    {{#if trait}}
        {{>"modules/betterrolls-swade2/templates/trait_roll_partial.hbs"}}
        {{>"modules/betterrolls-swade2/templates/trait_result_partial.hbs"}}
    {{/if}}
    <div class="brsw-damage-section">
        <div class="brsw-form brsw-button-row brsw-form-options brsw-damage-button-row" {{#unless damage}}hidden{{/unless}}>
            <span>
                {{localize 'BRSW.Damage'}}
            </span>
            <span class="brsw-flex brsw-gap-1">
                <button id="roll-damage" class="brsw-damage-button brsw-form brsw-item-button" title="{{localize 'BRSW.Damage'}}">
                    <i class="fas fa-dice"></i>
                </button>
                <button id="roll-raise-damage" class="brsw-damage-button brsw-form brsw-item-button" title="{{localize 'BRSW.RaiseDamage'}}">
                    <i class="fas fa-plus"></i><i class="fas fa-dice-six"></i>
                </button>
            </span>
        </div>
        {{>"modules/betterrolls-swade2/templates/damage_partial.hbs"}}
    </div>
    {{#if swade_templates}}
        <div class="brsw-form brsw-swade-templates">
            <h4 class="brsw-item-subheading">
                <i class="fa-solid fa-ruler-combined"></i> {{localize 'BRSW.Templates'}}
            </h4>
            <div class="brsw-form-options brsw-templates-options">
                {{#each swade_templates}}
                    <button class="brsw-template-button brsw-sub-button brsw-item-button" data-size="{{this.type}}"><i class="fas fa-ruler-combined"></i> {{localize this.label}}</button>
                {{/each}}
            </div>
        </div>
    {{/if}}
    {{#if (eq item.type "consumable")}}
        <div class='brsw-consumable-charges'>
            {{localize 'SWADE.Charges'}}:
            <span class='current-pp'>{{item.system.charges.default.value}}</span>
            &nbsp;/&nbsp;
            <span class='max-pp'>{{item.system.charges.default.max}}</span>
        </div>
        <button class="brsw-use-consumable-button brsw-sub-button brsw-form brsw-item-button">
            {{localize 'SWADE.Consumable.Use'}}
        </button>
    {{/if}}
    {{#if hasFooterButtons}}
        {{#if macro_buttons}}
            <div class="brsw-form brsw-macro-buttons">
                <h4 class="brsw-item-subheading">
                    <i class="fa-solid fa-code"></i> {{localize 'BRSW.Macros'}}
                </h4>
                <div class="brsw-item-action-button-group">
                    {{#each macro_buttons}}
                        <button class="brsw-macro-button brsw-sub-button brsw-item-button" data-macro="{{this.key}}"><i class="fas fa-code"></i> {{this.name}}</button>
                    {{/each}}
                </div>
            </div>
        {{/if}}
        {{#if resist_buttons}}
            <div class="brsw-form brsw-resist-buttons">
                <h4 class="brsw-item-subheading">
                    <i class="fa-solid fa-ban"></i> {{localize 'BRSW.Resistance'}}
                </h4>
                <div class="brsw-item-action-button-group">
                    {{#each resist_buttons}}
                        <button class="brsw-resist-button brsw-sub-button brsw-item-button" data-trait="{{this.trait}}" data-trait-mod="{{this.trait_mod}}">
                            <i class="fa-solid fa-ban"></i> {{this.name}}
                        </button>
                    {{/each}}
                </div>
            </div>
        {{/if}}
    {{/if}}
</div>