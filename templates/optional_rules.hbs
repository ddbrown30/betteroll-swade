<div>
    <h2>{{localize "BRSW.Settings.OptionalRules.Name"}}</h2>
    <table>
        {{#each rules}}
            <tr>
                <td>
                    <input type="checkbox" name="{{{this.id}}}" {{#if this.enabled}}checked="checked" {{/if}}>
                    <label>{{this.name}}</label>
                </td>
            </tr>
        {{/each}}
    </table>
    <button type="submit"><i class="far fa-save"></i>{{localize "BRSW.Save"}}</button>
</div>