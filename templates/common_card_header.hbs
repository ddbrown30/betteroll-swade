<div id="brc-{{id}}" class="brsw-card-header-row">
    <div class="brsw-actor-img">
        <img src="{{{actorImg}}}" alt="Actor portrait" style="transform: scale({{actorImgScale}});">
    </div>
    {{#if vehicleActor}}
        <div class="brsw-vehicle-img-wrapper">
            <img class="brsw-vehicle-img" src="{{{vehicleActor.img}}}" alt="Vehicle portrait">
        </div>
    {{/if}}
    <div class="brsw-header-title-wrapper">
        <span class="brsw-header-title-group">
            <a class="{{#if description}}brsw-collapse-button{{/if}} brsw-header-title" data-collapse="brsw-description">{{header.title}}</a>
            {{#if showTools}}
                <span class="brsw-common-tools brsw-form">
                    {{#if showRepeat}}
                        <i class="brsw-repeat-card brsw-common-tool fas fa-redo" data-tooltip-text="{{localize "BRSW.Tooltip.RepeatButton"}}"></i>
                    {{/if}}
                    {{#if showSave}}
                        <i class="brsw-owner-trusted-only brsw-save-macro brsw-common-tool fa fa-save" data-tooltip-text="{{localize "BRSW.Tooltip.SaveMacroButton"}}"></i>
                    {{/if}}
                    {{#if showManualMods}}
                        <i class="brsw-manual-mods brsw-common-tool fas fa-plus-minus" data-tooltip-text="{{localize "BRSW.Tooltip.OpenModsButton"}}"></i>
                    {{/if}}
                </span>
            {{/if}}
        </span>
    </div>
    <div class="brsw-header-img-wrapper">
        <div class="brsw-header-img-slot">
            {{#if header.img}}
                <img class="brsw-header-img" src="{{{header.img}}}" alt="Item image">
            {{/if}}
        </div>
    </div>
</div>
<div class="brsw-description {{#if collapse_descriptions}}brsw-collapsed{{/if}}">{{{description}}}</div>
<div class="brsw-header-divider brsw-groove-border"></div>
{{#if warning}}
    <div class="brsw-card-note brsw-card-note-warning">
        {{{warning}}}
    </div>
{{/if}}
{{#if extra_text}}
    <div class="brsw-card-note brsw-card-note-extra">
        {{{extra_text}}}
    </div>
{{/if}}