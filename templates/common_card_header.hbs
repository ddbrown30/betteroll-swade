<div id="brc-{{id}}" class="brsw-card-header-row">
    <div>
        <img class="brsw-actor-img" src="{{{actor.img}}}" alt="Actor portrait">
    </div>
    {{#if vehicle_actor}}
        <div class="brsw-vehicle-img-wrapper">
            <img class="brsw-vehicle-img" src="{{{vehicle_actor.img}}}" alt="Vehicle portrait">
        </div>
    {{/if}}
    <div class="brsw-header-title-wrapper">
        <span class="brsw-header-title-group">
            <a class="brsw-collapse-button brsw-header-title" data-collapse="brsw-description">{{header.title}}</a>
            <span class="brsw-common-tools brsw-form">
                <i class="brsw-repeat-card brsw-common-tool fas fa-redo"></i>
                {{#unless vehicle_actor}}
                    <i class="brsw-owner-trusted-only brsw-save-macro brsw-common-tool fa fa-save"></i>
                {{/unless}}
                {{#if supports_manual_mods}}
                    <i class="brsw-manual-mods brsw-common-tool fas fa-plus-minus"></i>
                {{/if}}
            </span>
            {{#if tooltip}}
                <div id="tooltip-description" role="tooltip" class="brsw-tooltip">
                    {{{tooltip}}}
                </div>
            {{/if}}
        </span>
    </div>
    <div class="brsw-header-img-wrapper">
        <div class="brsw-header-img-slot">
            {{#if header.img}}
                <img class="brsw-header-img" src="{{{header.img}}}" alt="Item image">
            {{/if}}
        </div>
    </div>
</div>
<div class="brsw-description {{#if collapse_descriptions}}brsw-collapsed{{/if}}">{{{description}}}</div>
<div class="brsw-header-divider brsw-groove-border"></div>
{{#if warning}}
    <div class="brsw-card-note brsw-card-note-warning">
        {{{warning}}}
    </div>
{{/if}}
{{#if extra_text}}
    <div class="brsw-card-note brsw-card-note-extra">
        {{{extra_text}}}
    </div>
{{/if}}